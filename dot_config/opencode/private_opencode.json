{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "lsp": true,
  "formatter": true,
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "experimental": {
    "background_compaction": true,
    "todo": true
  },
  "permissions": [
    {
      "action": "read",
      "resource": "~/.local/share/opencode/auth.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.local/share/opencode/mcp-auth.json",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "browse": {
        "type": "local",
        "command": [
          "browse",
          "mcp"
        ],
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
