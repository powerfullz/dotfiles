{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [],
  "lsp": true,
  "formatter": true,
  "providers": {
    "google": {
      "settings": {
        "baseURL": "https://uuapi.net/",
        "apiKey": "{env:UUAPI_API_KEY}"
      }
    },
    "sss": {
      "name": "sss",
      "canonical": "openai",
      "settings": {
        "baseURL": "https://node-hk.sssaiapi.com/api/v1",
        "apiKey": "{env:SSS_API_KEY}"
      },
      "models": {
        "gpt-6.2-astra": {
          "name": "GPT-6.2 Astra",
          "settings": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "gpt-6.2-sol": {
          "name": "GPT-6.2 Sol",
          "settings": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "settings": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol",
          "settings": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "settings": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "settings": {
            "store": false,
            "reasoningEffort": "high",
            "textVerbosity": "medium",
            "reasoningSummary": "auto",
            "include": [
              "reasoning.encrypted_content"
            ]
          }
        }
      }
    },
    "sss-anthropic": {
      "name": "sss-anthropic",
      "canonical": "anthropic",
      "settings": {
        "baseURL": "https://node-hk.sssaiapi.com/api/v1",
        "apiKey": "{env:SSS_API_KEY}"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8"
        },
        "claude-opus-4-7": {
          "name": "Claude Opus 4.7"
        },
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6"
        },
        "claude-opus-5": {
          "name": "Claude Opus 5"
        },
        "claude-opus-5-5": {
          "name": "Claude Opus 5.5"
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6"
        },
        "claude-sonnet-5": {
          "name": "Claude Sonnet 5"
        },
        "claude-sonnet-5-5": {
          "name": "Claude Sonnet 5.5"
        },
        "claude-haiku-4-5-20251001": {
          "name": "Claude Haiku 4.5"
        },
        "claude-haiku-5-5": {
          "name": "Claude Haiku 5.5"
        },
        "claude-fable-5": {
          "name": "Claude Fable 5"
        },
        "claude-fable-5-1": {
          "name": "Claude Fable 5.1"
        },
        "claude-fable-5-2": {
          "name": "Claude Fable 5.2"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000
    },
    "buffer": "15%"
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 2
  },
  "permissions": [
    {
      "action": "read",
      "resource": "~/.local/share/opencode/auth.json",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "cherry-*",
      "effect": "deny"
    },
    {
      "action": "skill",
      "resource": "code-mate-opencode",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "~/.local/share/opencode/mcp-auth.json",
      "effect": "deny"
    }
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "cloudflare": {
        "type": "remote",
        "url": "https://mcp.cloudflare.com/mcp",
        "oauth": {}
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ]
      },
      "browse": {
        "type": "local",
        "command": [
          "browse",
          "mcp"
        ],
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
