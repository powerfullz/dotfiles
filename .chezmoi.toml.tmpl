{{- $host := "" -}}
{{- if eq .chezmoi.os "windows" -}}
{{- /* Windows 用不到 Linux 的 host 专属事实，直接固定，省掉无意义提问。 */ -}}
{{- $host = "windows" -}}
{{- else -}}
{{- $host = promptStringOnce . "host" "Host name (laptop/desktop/server)" -}}
{{- end -}}
# 本机身份。这个文件只回答一个问题：我是哪台机器。
# 具体值都在 .chezmoidata/ 里，随仓库走。
# promptStringOnce：已配置过就不再追问，重跑 chezmoi init 也不会覆盖你的选择。

[data]
    host = {{ $host | quote }}
