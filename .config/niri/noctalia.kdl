layout {

    focus-ring {
        active-color   "#aacaec"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#aacaec"
        inactive-color "#121315"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#aacaec"
        inactive-color "#8cabcc"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#aacaec80"
    }
}

recent-windows {
    highlight {
        active-color "#aacaec"
        urgent-color "#ffb4ab"
    }
}
